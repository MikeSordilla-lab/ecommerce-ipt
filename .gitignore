# Secrets and environment-specific configuration
.env
.env.*
!.env.example
!.env.*.example

# Dependency folders
node_modules/
vendor/
mobile/node_modules/

# Build output and framework caches
dist/
build/
coverage/
.expo/
mobile/.expo/
.next/
.vite/

# Logs and debug output
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
debug.log
error.log

# Local editor and OS files
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/

# Local agent/tooling workspaces
.scratch/
.kilo/
.opencode/
.playwright-mcp/
.superpowers/
~/

# Runtime uploads generated in development or production
uploads/profiles/
uploads/products/product_new_*

# Keep seeded product catalog images available for deployments
!uploads/products/Products/
!uploads/products/Products/**

# Temporary and backup files
*.tmp
*.temp
*.bak
*.backup
*.swp
*.swo
.htaccesss

# Local databases and dumps
*.sqlite
*.sqlite3
*.db
*.dump
