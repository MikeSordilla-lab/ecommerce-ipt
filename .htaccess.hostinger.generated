# Generated Hostinger deployment config for lightyellow-pelican-537169.hostingersite.com
# Copy these lines into public_html/.htaccess on Hostinger.
# Replace YOUR_DATABASE_PASSWORD_HERE with the real MySQL password from hPanel.
# Do not commit or share the real .htaccess file after adding the password.

SetEnv APP_ENV production
SetEnv APP_DEBUG false
SetEnv SITE_URL https://lightyellow-pelican-537169.hostingersite.com
SetEnv DB_HOST localhost
SetEnv DB_PORT 3306
SetEnv DB_NAME u145917473_ecommerce
SetEnv DB_USER u145917473_one
SetEnv DB_PASS YOUR_DATABASE_PASSWORD_HERE
SetEnv SESSION_COOKIE_SECURE true
SetEnv SESSION_COOKIE_SAMESITE Strict

# Optional PHP upload settings. Remove these if Hostinger returns 500 Internal Server Error.
php_value upload_max_filesize 20M
php_value post_max_size 25M
php_value max_execution_time 180
php_value max_input_time 180

# Basic hardening
Options -Indexes
